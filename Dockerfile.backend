FROM python:3.12-slim

# Install OS-level dependencies required by Playwright/Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies (cached layer — only re-runs when requirements change)
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Install Chromium + all its OS-level dependencies in one step
RUN python -m playwright install --with-deps chromium

# Copy application code
COPY backend ./backend
COPY data ./data

# Environment overrides safe to bake in (non-sensitive, Docker-specific)
ENV API_HOST=0.0.0.0 \
    API_PORT=8000 \
    PLAYWRIGHT_HEADLESS=true

EXPOSE 8000

# Single worker — required because APScheduler and browser state are in-process
CMD ["python", "-m", "uvicorn", "backend.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
