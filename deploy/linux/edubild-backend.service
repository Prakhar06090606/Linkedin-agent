[Unit]
Description=EduBuild Agent Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/edubild-social-agent
ExecStart=/usr/bin/python3 -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=/opt/edubild-social-agent/.env

[Install]
WantedBy=multi-user.target
